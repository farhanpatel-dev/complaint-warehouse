# Copy to .env and adjust. docker compose and the Python settings both read this file.

# --- Postgres -----------------------------------------------------------------
POSTGRES_DB=complaints
POSTGRES_USER=cw
POSTGRES_PASSWORD=cw
POSTGRES_PORT=5433

# Host port 5433 avoids clashing with a locally installed Postgres on 5432.
# Used by Python when running on the host. Inside compose the app overrides it to point at `db`.
DATABASE_URL=postgresql://cw:cw@localhost:5433/complaints
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# --- API ----------------------------------------------------------------------
API_PORT=8000
LOG_LEVEL=INFO

# --- Ingestion ----------------------------------------------------------------
# First incremental API load starts here when no watermark exists yet.
INGEST_START_DATE=2025-01-01
# Re-read this many days behind the watermark to catch late company responses.
INGEST_LOOKBACK_DAYS=30
INGEST_WINDOW_DAYS=1
INGEST_BATCH_SIZE=10000
API_PAGE_SIZE=1000
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=5
DATA_DIR=data
